{
  "crons": [
    {
      "path": "/api/recordatorios",
      "schedule": "0 17 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/oauth-recurso"
    },
    {
      "source": "/.well-known/oauth-protected-resource/:path*",
      "destination": "/api/oauth-recurso"
    },
    {
      "source": "/oauth/:path*",
      "destination": "/index.html"
    }
  ]
}
